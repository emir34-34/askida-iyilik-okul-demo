# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env repoya girmez.

# Uzun ve rastgele bir değer. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Geliştirirken 1, aksi halde 0
DJANGO_DEBUG=1

# Virgülle ayrılmış adresler
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Örnek veri komutunun (python manage.py ornek_veri) bütün örnek kullanıcılara vereceği şifre
DEMO_SIFRE=
