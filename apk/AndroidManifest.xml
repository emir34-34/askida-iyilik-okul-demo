<?xml version="1.0" encoding="utf-8"?>
<!-- Askıda İyilik APK kabuğu: Django demosunu tam ekran açan bir WebView (teknoloji.md, S-11). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.emir3434.askidaiyilik">

    <!-- Sunucuya bağlanmak için. Başka hiçbir izin istenmez: kamera, konum, rehber yok (T-03). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: demo sunucusu http (şifresiz) çalıştığı için. Gerçek kullanımda https olmalı. -->
    <application
        android:label="@string/uygulama_adi"
        android:icon="@drawable/ikon"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
